<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Utility.Server</RootNamespace>
    <AssemblyName>Utility.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <!--
    The sync service walks Dropbox (Utility.DropBox) and writes to SQL Server
    (this project), so it needs both. Utility.DropBox itself stays free of EF and
    knows nothing about the database.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Utility.DropBox\Utility.DropBox.csproj" />
  </ItemGroup>

  <!--
    SQL scripts for tables this app owns (ml.DropBoxNode). They are the source of
    truth for that schema: this project deliberately emits no migrations, so the
    scripts are applied by hand (sqlcmd -I -i <file>).

    Embedded so they ship inside the assembly and can be read at runtime for
    setup checks; also copied to the output folder so they can be run directly
    from a deployed install without digging through the binaries.
  -->
  <ItemGroup Label="Schema scripts">
    <EmbeddedResource Include="Sql\CreateDropBoxNode.sql" />
    <EmbeddedResource Include="Sql\ResolveDropBoxNodeParents.sql" />
    <EmbeddedResource Include="Sql\SelectDropBoxNodes.sql" />
  </ItemGroup>

  <ItemGroup Label="Schema scripts (copy to output)">
    <Content Include="Sql\CreateDropBoxNode.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Sql\ResolveDropBoxNodeParents.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Sql\SelectDropBoxNodes.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>