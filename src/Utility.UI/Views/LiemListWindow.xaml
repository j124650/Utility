<Window x:Class="Utility.UI.Views.LiemListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Liem's List"
        Height="900" Width="1400"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#FFFFFF">

    <Grid>
        <!--
          The report itself: a WebView2 that fills the window and navigates to the file
          that was written (docs/liems-list-spec.md §6.7). There is no toolbar of the
          window's own - the report's own header holds everything the reader needs.
        -->
        <wv2:WebView2 x:Name="Browser" />

        <!--
          The failure state. A missing WebView2 runtime is reported HERE rather than
          shown as a blank page (§6.8).
        -->
        <Border x:Name="FailurePanel"
                Visibility="Collapsed"
                Background="#FFFFFF"
                Padding="32">
            <StackPanel VerticalAlignment="Center" MaxWidth="640">
                <TextBlock Text="The report could not be opened."
                           FontSize="18" FontWeight="SemiBold" Foreground="#111827"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="FailureMessage"
                           FontSize="13" Foreground="#6B7280"
                           Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
