<UserControl x:Class="Utility.UI.Views.FinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Utility.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FinderViewModel}">

    <UserControl.Resources>
        <!--
          The verdict and file-state icons. They are TEXT, not glyphs from a font, so they
          render the same wherever the app runs - and they carry no colour, by design: the
          icon says what happened, the row is not painted.
        -->
        <Style x:Key="IconCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Verdict" />
        </Style>

        <!--
          A card's label. The label column is a FIXED width in both the parent and the child
          card, so the four state lines - state, size check, size, dimensions - line up
          across the row and the two sides can be read against each other (§18.4).
        -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
          A card's value. It TRUNCATES with an ellipsis rather than clipping, the way the
          record is drawn in §18.4 ("D17343ED…").
        -->
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="InfoHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B7280" />
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
          A collapsible section. The header carries the collapse/expand button at its left,
          and the body folds away under it. Each section collapses on its own.
        -->
        <Style x:Key="InfoSection" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="#334155" />
        </Style>

        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Finder" Style="{StaticResource HeaderText}" />
                <TextBlock Text="Gathers every parent/child pair and reports what the Finder would do about it. Read-only — nothing is written to the library."
                           Style="{StaticResource SubHeaderText}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="File name, folder or candidate" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FilterText}" Margin="0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0" MinWidth="170">
                        <TextBlock Text="Verdict" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding VerdictFilterOptions}"
                                  SelectedItem="{Binding VerdictFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Bottom">
                        <Button Content="Run the pass" Command="{Binding RunCommand}" MinWidth="110" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding RowsDisplay}" FontSize="11" Foreground="#6B7280"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#6B7280" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Table and info area, separated by a splitter. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!--
              The splitter takes 25% of the width by default: the table's column is three
              shares and the info area's is one, and the splitter redistributes those shares
              when it is dragged.
            -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="#E2E8F0" />

            <DataGrid x:Name="PairsGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding Selected}"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      CanUserSortColumns="True"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <!--
                      The record is FOUR columns (§14.2, §18.4): the icon, the parent, the
                      child, the verdict. The parent and the child are stack panels of
                      label/value lines, and the four state lines - state, size check, size,
                      dimensions - are in the same order in both, so they line up across the
                      row and the two sides are read against each other.

                      The candidates are NOT here. They are in the info area (§14.4), which
                      lists every one of them - rank, name, what matched, size, dimensions,
                      date, path - rather than only the best.
                    -->

                    <!-- The leading icon says the verdict. No colour anywhere. -->
                    <DataGridTemplateColumn Header="" Width="44" SortMemberPath="Verdict">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource IconCell}" Text="{Binding VerdictIcon}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Parent: everything about the parent file. -->
                    <DataGridTemplateColumn Header="Parent" Width="2*" MinWidth="290" SortMemberPath="ParentFileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="File name" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ParentFileName}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParentFolder}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Id" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ParentId}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="State" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Parent.State}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Size check" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Parent.SizeCheck}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Size" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Parent.SizeDisplay}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Dimensions" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Parent.Dimensions}" Style="{StaticResource CardValue}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Child: everything about the child file. The same four state lines. -->
                    <DataGridTemplateColumn Header="Child" Width="2*" MinWidth="250" SortMemberPath="ChildId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ChildId}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChildCategoryName}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Variant" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ChildVariantName}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="State" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Child.State}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Size check" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Child.SizeCheck}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Size" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Child.SizeDisplay}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Dimensions" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Child.Dimensions}" Style="{StaticResource CardValue}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Verdict: the outcome and its note. -->
                    <DataGridTemplateColumn Header="Verdict" Width="1.5*" MinWidth="200" SortMemberPath="Verdict">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,8,4">
                                    <TextBlock Text="{Binding Verdict}" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VerdictNote}" FontSize="10" Foreground="#94A3B8"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Info area -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Empty state: no row selected. -->
                    <TextBlock Grid.Row="0"
                               Text="Select a row in the table to see its detail."
                               Style="{StaticResource InfoValue}"
                               Foreground="#6B7280"
                               Margin="0,0,0,10"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- The sections. -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>

                            <!-- Parent -->
                            <Expander Style="{StaticResource InfoSection}" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Mode=TwoWay}">
                                            <TextBlock Text="▾" />
                                        </ToggleButton>
                                        <TextBlock Text="PARENT" Style="{StaticResource InfoHeader}" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,6,0,8">
                                    <TextBlock Text="{Binding ParentFileName}" Style="{StaticResource InfoValue}" FontWeight="SemiBold" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="State" Style="{StaticResource InfoLabel}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ParentState}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Style="{StaticResource InfoLabel}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParentSize}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Size check" Style="{StaticResource InfoLabel}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ParentSizeCheck}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Dimensions" Style="{StaticResource InfoLabel}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ParentDimensions}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fault" Style="{StaticResource InfoLabel}" Margin="0,0,10,0"
                                                   Visibility="{Binding HasParentFault, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ParentFault}" Style="{StaticResource InfoValue}"
                                                   Foreground="#6B7280"
                                                   Visibility="{Binding HasParentFault, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- Child -->
                            <Expander Style="{StaticResource InfoSection}" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Mode=TwoWay}">
                                            <TextBlock Text="▾" />
                                        </ToggleButton>
                                        <TextBlock Text="CHILD" Style="{StaticResource InfoHeader}" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,6,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="State" Style="{StaticResource InfoLabel}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ChildState}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Style="{StaticResource InfoLabel}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChildSize}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Size check" Style="{StaticResource InfoLabel}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ChildSizeCheck}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Dimensions" Style="{StaticResource InfoLabel}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ChildDimensions}" Style="{StaticResource InfoValue}" />

                                        <!-- Which rendition the child is (§14.2). -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Category" Style="{StaticResource InfoLabel}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ChildCategoryName}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Variant" Style="{StaticResource InfoLabel}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ChildVariantName}" Style="{StaticResource InfoValue}" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Fault" Style="{StaticResource InfoLabel}" Margin="0,0,10,0"
                                                   Visibility="{Binding HasChildFault, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ChildFault}" Style="{StaticResource InfoValue}"
                                                   Foreground="#6B7280"
                                                   Visibility="{Binding HasChildFault, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- Verdict and the rules it rests on -->
                            <Expander Style="{StaticResource InfoSection}" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Mode=TwoWay}">
                                            <TextBlock Text="▾" />
                                        </ToggleButton>
                                        <TextBlock Text="VERDICT" Style="{StaticResource InfoHeader}" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,6,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding VerdictIcon}" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding VerdictText}" Style="{StaticResource InfoValue}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding NoteText}" Style="{StaticResource InfoValue}" Foreground="#6B7280" Margin="0,2,0,0" />

                                    <!-- The rules: ✓ where the rule is respected, ✕ where it is not. -->
                                    <ItemsControl ItemsSource="{Binding Rules}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="{Binding Mark}" FontSize="12" Width="16" />
                                                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#334155" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <!-- Candidates -->
                            <Expander Style="{StaticResource InfoSection}" IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Mode=TwoWay}">
                                            <TextBlock Text="▾" />
                                        </ToggleButton>
                                        <TextBlock Text="CANDIDATES" Style="{StaticResource InfoHeader}" />
                                        <TextBlock Text="{Binding Candidates.Count, StringFormat=({0})}" Style="{StaticResource InfoLabel}"
                                                   Margin="6,0,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,6,0,8">
                                    <TextBlock Text="No candidates for this pair."
                                               Style="{StaticResource InfoValue}" Foreground="#6B7280"
                                               Visibility="{Binding HasCandidates, Converter={StaticResource InverseBoolToVis}}" />

                                    <ListBox ItemsSource="{Binding Candidates}"
                                             SelectedItem="{Binding SelectedCandidate}"
                                             MaxHeight="200"
                                             BorderBrush="#E2E8F0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Rank}" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding WhatMatched}" FontSize="10" Foreground="#6B7280" />
                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="10" Foreground="#6B7280" />
                                                    <TextBlock Text="{Binding Dimensions}" FontSize="10" Foreground="#6B7280" />
                                                    <TextBlock Text="{Binding ModifiedDisplay}" FontSize="10" Foreground="#6B7280" />
                                                    <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#94A3B8"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>

                            <!-- Preview: the candidate's image, fetched from Dropbox and discarded. -->
                            <Expander Style="{StaticResource InfoSection}" IsExpanded="True"
                                      Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource SectionToggle}"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}, Mode=TwoWay}">
                                            <TextBlock Text="▾" />
                                        </ToggleButton>
                                        <TextBlock Text="PREVIEW" Style="{StaticResource InfoHeader}" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Margin="0,6,0,8">
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" Background="#FFFFFF">
                                        <Image Source="{Binding PreviewImage}"
                                               MaxHeight="220"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Left" />
                                    </Border>

                                    <!-- Whose image this is: the candidate's own name and dimensions (§18.7). -->
                                    <TextBlock Text="{Binding SelectedCandidate.Name}" FontSize="11" Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="10" Foreground="#6B7280">
                                        <Run Text="{Binding SelectedCandidate.Dimensions, Mode=OneWay}" />
                                        <Run Text="{Binding SelectedCandidate.SizeDisplay, Mode=OneWay, StringFormat=' · {0} bytes'}" />
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Load from DropBox" Command="{Binding PreviewCommand}" />
                                        <TextBlock Text="{Binding PreviewState}" FontSize="11" Foreground="#6B7280"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
