<UserControl x:Class="Utility.UI.Views.LiemListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Utility.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LiemListViewModel}">

    <UserControl.Resources>
        <!-- The same card styles the Finder's table uses (§18.4). -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="IconCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Liem's List" Style="{StaticResource HeaderText}" />
                <TextBlock Text="The pairs the verdict leaves unresolved — no original found by size, or nothing to restore from at all. A report on the Finder's scan, not a second one."
                           Style="{StaticResource SubHeaderText}" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Load the list" Command="{Binding LoadCommand}" MinWidth="120" />
                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#6B7280"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The grid and the detail, separated by a splitter. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="#E2E8F0" />

            <!-- The same four columns as the Finder's table (§14.2, §14.5). -->
            <DataGrid x:Name="ListGrid"
                      Grid.Column="0"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding Selected}"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      CanUserSortColumns="True"
                      AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="44" SortMemberPath="Verdict">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource IconCell}" Text="{Binding VerdictIcon}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Parent" Width="2*" MinWidth="290" SortMemberPath="ParentFileName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="File name" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ParentFileName}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParentFolder}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Id" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ParentId}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="State" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Parent.State}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Size check" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Parent.SizeCheck}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Size" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Parent.SizeDisplay}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Dimensions" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Parent.Dimensions}" Style="{StaticResource CardValue}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Child" Width="2*" MinWidth="250" SortMemberPath="ChildId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ChildId}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChildCategory}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Variant" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ChildVariant}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="State" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Child.State}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Size check" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Child.SizeCheck}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Size" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Child.SizeDisplay}" Style="{StaticResource CardValue}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Dimensions" Style="{StaticResource CardLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Child.Dimensions}" Style="{StaticResource CardValue}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Verdict" Width="1.5*" MinWidth="200" SortMemberPath="Verdict">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,8,4">
                                    <TextBlock Text="{Binding Verdict}" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VerdictNote}" FontSize="10" Foreground="#94A3B8"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Detail: why the pair is on the list, and the candidates that were rejected. -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Select a row to see why it is on the list."
                               FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="PAIR" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                        <TextBlock Text="{Binding SelectedFileName}" FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />

                        <TextBlock Text="VERDICT" FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{Binding SelectedVerdict}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedNote}" FontSize="11" Foreground="#6B7280"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />

                        <TextBlock Text="CANDIDATES" FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{Binding SelectedCandidates}" FontSize="11" Foreground="#334155"
                                   FontFamily="Consolas" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
