<UserControl x:Class="Utility.UI.Views.DropBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Utility.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DropBoxViewModel}">

    <UserControl.Resources>
        <!--
          The blur behind the listing's busy cover.

          WPF has no backdrop filter: an element's Effect blurs THAT element, never
          what sits behind it. So the grid carries the blur and the cover above it is
          left translucent - that is what lets the blurred shapes show through.
        -->
        <Style x:Key="BlurWhileListing" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <BlurEffect Radius="6" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          The cells.

          The grid's own cell template draws a black border around the cell that was
          clicked, even though what is selected is the row. The row is the selection -
          it is what fills the item-info pane - so the cell's own border goes, and
          the content sits centred in the row.
        -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="CellBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Content"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="CellBorder" Property="Background"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          The toolbar: up, the namespace, the path, and the actions that work on what
          the path shows.

          It wears the app's own toolbar look - a white panel, a light border, rounded
          corners - the same as the Finder's toolbar and the dashboard's, so the tabs
          read as one app. The ToolBar inside it is transparent, so the border around it
          is the only one.
        -->
        <Border Grid.Row="0"
                Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Up, and the namespace the path belongs to -->
                    <DockPanel Grid.Column="0">
                        <ToolBarTray DockPanel.Dock="Top" Background="Transparent">
                            <ToolBar Style="{StaticResource FlatToolBar}">
                                <Button Style="{StaticResource ToolbarButton}"
                                        Command="{Binding GoUpCommand}"
                                        IsEnabled="{Binding CanGoUp}"
                                        ToolTip="Up one level">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74A;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="Up" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!--
                                  The namespace, with no label in front of it: the drop-down
                                  says which namespace the path belongs to, and its own
                                  tooltip names it.
                                -->
                                <ComboBox ItemsSource="{Binding Namespaces}"
                                          SelectedItem="{Binding SelectedNamespace}"
                                          DisplayMemberPath="DisplayLabel"
                                          MaxWidth="320" Margin="8,0,0,0" Padding="6,4"
                                          VerticalAlignment="Center"
                                          ToolTip="Personal space, or a team root. Team folders are not visible in Personal." />
                            </ToolBar>
                        </ToolBarTray>
                    </DockPanel>

                    <!-- The path the grid is showing -->
                    <TextBox Grid.Column="1" Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" Margin="0,0,12,0"
                             VerticalContentAlignment="Center"
                             KeyDown="OnPathKeyDown">
                        <TextBox.ToolTip>
                            <TextBlock Text="Type a path and press Enter, e.g. /Images-Catalogs Team Folder/LightBoxPics" />
                        </TextBox.ToolTip>
                    </TextBox>

                    <!-- The actions that work on what the path shows -->
                    <DockPanel Grid.Column="2">
                        <ToolBarTray DockPanel.Dock="Top" Background="Transparent">
                            <ToolBar Style="{StaticResource FlatToolBar}">
                                <Button Style="{StaticResource ToolbarButton}"
                                        Command="{Binding GoToPathCommand}"
                                        ToolTip="Go to this path">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AD;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="Go" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ToolbarButton}"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="Re-read this folder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!--
                                  Sync From Here: the two-phase sync, started at the branch the
                                  tab is showing. The enrichment is scoped to that branch, so
                                  the run does not spend the account's allowance on the rest of
                                  the namespace.

                                  It is disabled in the personal space (a path means nothing
                                  without a team root) and while a walk is running.
                                -->
                                <Button Style="{StaticResource ToolbarButton}"
                                        Command="{Binding SyncFromHereCommand}"
                                        IsEnabled="{Binding CanSyncFromHere}"
                                        ToolTip="{Binding SyncFromHereHint}"
                                        Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="Sync From Here" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </ToolBar>
                        </ToolBarTray>
                    </DockPanel>
                </Grid>

                <!--
                  Tree depth and the tree's outputs. Hidden, not removed: the commands and
                  the view model's properties stay, so the row comes back by changing one
                  flag.
                -->
                <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Tree depth" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding TreeDepth}" Width="46" Margin="0,0,8,0"
                             VerticalContentAlignment="Center" />

                    <Button Content="Build tree JSON" Command="{Binding BuildTreeCommand}" />
                    <Button Content="Save JSON…" Command="{Binding SaveJsonCommand}"
                            IsEnabled="{Binding HasTreeJson}" />
                    <Button Content="Download file…" Command="{Binding DownloadCommand}" />

                    <TextBlock Text="{Binding TreeSummary}" FontSize="12" Foreground="#374151"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Listing + metadata detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!--
              The listing, and the local busy screen over it.

              While the folder is being fetched the grid still shows the old
              contents, so the grid is blurred and covered: a click on a row that is
              about to be replaced would navigate somewhere the user did not mean.
            -->
            <Grid Grid.Column="0" Margin="0,0,0,8" MinHeight="180">
                <Border Style="{StaticResource BlurWhileListing}">
                    <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Entries}"
                              SelectionMode="Single"
                              CellStyle="{StaticResource GridCell}"
                              FontSize="14.4"
                              RowHeight="30"
                              SelectionChanged="OnSelectionChanged"
                              MouseDoubleClick="OnRowDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!--
                  The cover: translucent, so the blurred grid shows through, and
                  hit-testable, so the grid underneath cannot be clicked.
                -->
                <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <Border Background="#FFFFFF" Opacity="0.6" />
                    <TextBlock Text="Please wait.."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="#6B7280" />
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Metadata pane: per-file info, plus the JSON preview -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Item info" Style="{StaticResource HeaderText}" />

                    <TextBlock Grid.Row="1" Text="{Binding SelectedEntryDetails}"
                               FontFamily="Consolas" FontSize="11" Foreground="#374151"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Tree JSON (hierarchical)"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox Grid.Row="1" Text="{Binding TreeJson, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 Visibility="{Binding HasTreeJson, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status: directly under the content it describes, so it is never off-screen -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="6" Padding="10,6">
            <StackPanel>
                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,6"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>