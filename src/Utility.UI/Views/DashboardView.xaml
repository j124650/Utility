<!--
  Dashboard = the synced Dropbox tree and a toolbar, nothing else.
  Media items / system id / library path / SQL connectivity moved to the window status bar.
  The tree occupies every remaining row and scrolls inside itself, so expanding a node
  scrolls the list rather than resizing the page.
-->
<UserControl x:Class="Utility.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Utility.UI.ViewModels"
             xmlns:sync="clr-namespace:Utility.Server.DropBoxSync;assembly=Utility.Server"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <UserControl.Resources>
        <!--
                          One row style, so every node has identical metrics and nothing reflows.

                          ItemsSource is bound EXPLICITLY to Children. A TreeView only auto-discovers a
                          child collection named "Items"; one named "Children" is ignored, so every node
                          rendered as a leaf with no expander - which looked exactly like broken data.

                          IsExpanded is deliberately NOT bound here. WPF resets it while preparing the
                          container, so a bound value loses that race and the node never opens.
                          DashboardView.xaml.cs copies the model's expansion onto the generated
                          containers instead, and Expanded/Collapsed write the user's clicks back.
                        -->
                        <Style x:Key="TreeRowStyle" TargetType="TreeViewItem">
                            <Setter Property="ItemsSource" Value="{Binding Children}" />
                            <Setter Property="MinHeight" Value="26" />
                            <Setter Property="Padding" Value="2,1,0,1" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Foreground" Value="#111827" />
                            <EventSetter Event="Loaded" Handler="OnTreeItemLoaded" />
                                                <EventSetter Event="Expanded" Handler="OnTreeItemExpanded" />
                                                <EventSetter Event="Collapsed" Handler="OnTreeItemCollapsed" />
                        </Style>

        <Style x:Key="StatPill" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Synced Dropbox index" FontSize="16" FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="Aggregates from ml.DropBoxNode — no Dropbox calls."
                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="24,0,0,0">
                    <Border Style="{StaticResource StatPill}" ToolTip="Objects present in the synced table.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="Objects " /><Run Text="{Binding Stats.TotalObjectsDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" ToolTip="Folders present in the synced table.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="Folders " /><Run Text="{Binding Stats.FoldersDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" ToolTip="Files present in the synced table.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="Files " /><Run Text="{Binding Stats.FilesDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" ToolTip="Files whose pixel dimensions were returned by Dropbox.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="With dims " /><Run Text="{Binding Stats.FilesWithDimensionsDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" ToolTip="Total size of synced files.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="Size " /><Run Text="{Binding Stats.TotalBytesDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" ToolTip="When the synced rows were last written.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="Synced " /><Run Text="{Binding Stats.LastSyncedDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" Background="#FEF2F2"
                            Visibility="{Binding Stats.ShowPending, Converter={StaticResource BoolToVis}}"
                            ToolTip="Folders whose listing did not complete. The sweep never deletes their contents.">
                        <TextBlock Text="{Binding Stats.NotSyncedHeadline, Mode=OneWay}" FontSize="12" Foreground="#B91C1C" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Read / Refresh" Command="{Binding RefreshStatsCommand}"
                            Padding="14,5" />
                    <!--
                      Expand all / Collapse all are hidden: the tree keeps the model's default
                      expansion, and the per-node chevrons still work.
                    -->
                    <Button Content="Expand all" Click="OnExpandAllClick" Padding="12,5" Margin="0,0,6,0"
                            Visibility="Collapsed" />
                    <Button Content="Collapse all" Click="OnCollapseAllClick" Padding="12,5"
                            Visibility="Collapsed" />
                </StackPanel>

                <!--
                  Sync strip: the only part of this page that talks to Dropbox.

                  There are no options here on purpose. The sync walks the folder tree from
                  the root down to the leaves, always, and always fetches each file's own
                  metadata - that is the only route to image dimensions, and skipping it
                  would blank the dimensions already stored. A depth or an enrichment
                  toggle would only narrow what gets synced, which is not a decision the
                  user should have to make to get a correct result.

                  The path is the only input: it is the folder the walk starts from.

                  While the walk runs, the app-level busy screen covers the whole window
                  and carries the live progress and the Stop button - so nothing is
                  reported here. The tree is re-read when that screen is dismissed.
                -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Sync from Dropbox"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <TextBox Grid.Column="1" Text="{Binding SyncPath, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="12" Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Dropbox folder to sync, relative to the team namespace root. The whole tree below it is walked." />

                        <!--
                          Two sync buttons, one path box.

                          "Sync" is the one-phase walk: it fetches every file's metadata
                          as it goes, which is ~97% of its traffic and buys the
                          dimensions.

                          "Sync New" is the two-phase walk: it lists the structure first
                          and then fetches the metadata of the files whose CONTENT
                          changed - so an unchanged file costs no per-file call at all.
                          Both read the same box, so both act on the folder the user
                          typed.
                        -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <!--
                              The one-phase "Sync" button is HIDDEN for now. The command
                              and the view model behind it are untouched, so it can come
                              back by changing one attribute.
                            -->
                            <Button Content="Sync" Command="{Binding RunSyncCommand}"
                                    Visibility="Collapsed"
                                    Padding="14,5" MinWidth="72" Margin="0,0,6,0"
                                    IsEnabled="{Binding CanRunSync}" />
                            <Button Content="Sync New" Command="{Binding RunSyncNewCommand}"
                                    Padding="14,5" MinWidth="86" Margin="0,0,6,0"
                                    IsEnabled="{Binding CanRunSync}"
                                    ToolTip="Two-phase sync: lists the structure, then fetches the metadata of the files whose content changed. An unchanged file costs no call." />

                            <!--
                              Enrich Only runs the SECOND phase on its own: the files a
                              previous sync marked as changed. It needs no path - the work
                              list is the set of rows tagged 'pending' - so the path box
                              does not apply to it.
                            -->
                            <Button Content="Enrich Only" Command="{Binding RunEnrichOnlyCommand}"
                                    Padding="14,5" MinWidth="86"
                                    IsEnabled="{Binding CanRunSync}"
                                    ToolTip="Fetches the metadata of the files the last sync marked as changed, and nothing else. Needs no path." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--
                  Tree: takes the whole remaining space and scrolls inside its own bounds. The
                  ScrollViewer sits on a fixed-height row, so expanding a node scrolls the content
                  and never changes the height of anything below it.

                  Virtualization is deliberately OFF. IsExpanded is a two-way binding, and a
                  recycled TreeViewItem carries its previous item's expansion state back through
                  that binding - which made "Expand all" appear to do nothing. With a synced
                  subtree this size the panel buys nothing.
                -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <!--
                          THE TREE IS COMMENTED OUT. It is not deleted - uncomment this block and
                          the tree comes back exactly as it was. What replaced it is the index's
                          figures, read as aggregates: the tree read every row of ml.DropBoxNode
                          and rebuilt the hierarchy, which took twenty minutes for a page that
                          shows a handful of numbers.
                        -->
                        <!--
                        <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}"
                                                                  ItemContainerStyle="{StaticResource TreeRowStyle}"
                                          BorderThickness="0" Background="Transparent"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <TreeView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            Fixed widths for the trailing columns. Auto-width columns size to content and
                                            ignore margin, which is what made the date and size overlap.
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="110" />
                                                                                <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>

                                        Glyph
                                        <Grid Grid.Column="0" Width="20">
                                            <TextBlock Text="{Binding IsFolder, Converter={StaticResource BoolToIcon}}"
                                                       FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Grid>

                                        Name. Synthetic (never-synced) ancestors are italic and muted.
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Margin="4,0,12,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}"
                                                   FontStyle="{Binding IsSynced, Converter={StaticResource BoolToFontStyle}}"
                                                   FontWeight="{Binding IsFolder, Converter={StaticResource BoolToWeight}}"
                                                   Foreground="{Binding IsSynced, Converter={StaticResource BoolToTextBrush}}" />

                                        Not fully listed
                                        <TextBlock Grid.Column="2" Text="⚠ not fully listed" FontSize="10" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" Foreground="#B91C1C"
                                                   Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="This folder's listing did not complete. The sweep will not delete what is inside it." />

                                        "not synced" marker for synthetic ancestors
                                        <TextBlock Grid.Column="3" Text="not synced" FontSize="10" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" Foreground="#94A3B8"
                                                   Visibility="{Binding IsSynced, Converter={StaticResource InverseBoolToVis}}"
                                                   ToolTip="This folder appears in a synced path but has no synced data of its own." />

                                        Dimensions
                                        <TextBlock Grid.Column="4" Text="{Binding DimensionsDisplay}" FontSize="11"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#7C3AED"
                                                   Visibility="{Binding HasDimensions, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="Pixel dimensions reported by Dropbox." />

                                        Size
                                                                        <TextBlock Grid.Column="5" Text="{Binding SizeDisplay}" FontSize="11"
                                                                                                                           TextAlignment="Right" Margin="0,0,20,0"
                                                                                                                           VerticalAlignment="Center" Foreground="#64748B" />

                                                                                                        Modified
                                                                                                                <TextBlock Grid.Column="6" Text="{Binding ModifiedDisplay}" FontSize="11"
                                                                                                                           TextAlignment="Right" Margin="0,0,4,0"
                                                                                                                           VerticalAlignment="Center" Foreground="#94A3B8" />
                                    </Grid>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        -->

                        <!--
                          The index's figures. Everything here is an aggregate over
                          ml.DropBoxNode - one scan, one row, no row materialization.
                        -->
                        <StackPanel Margin="20,16" VerticalAlignment="Top">

                            <!-- Totals -->
                            <UniformGrid Columns="4" Margin="0,0,0,18">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Synced objects" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Stats.TotalObjectsDisplay, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
                                    <TextBlock Text="rows in ml.DropBoxNode" FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Folders" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Stats.FoldersDisplay, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
                                    <TextBlock Text="directories" FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Files" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Stats.FilesDisplay, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
                                    <TextBlock Text="files" FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Total size" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding Stats.TotalBytesDisplay, Mode=OneWay}"
                                               FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
                                    <TextBlock Text="{Binding Stats.LastSyncedDisplay, Mode=OneWay}"
                                               FontSize="10" Foreground="#94A3B8" />
                                </StackPanel>
                            </UniformGrid>

                            <!-- Not fully listed -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                    CornerRadius="8" Padding="16,12"
                                    Visibility="{Binding Stats.ShowPending, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Stats.NotSyncedHeadline, Mode=OneWay}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#B91C1C" />
                                    <TextBlock Text="A folder whose listing did not complete. Its contents are unverified, not absent - the sweep never deletes them."
                                               FontSize="11" Foreground="#B91C1C" Margin="0,4,0,0" TextWrapping="Wrap" />

                                    <ItemsControl ItemsSource="{Binding Stats.NotSyncedGroups, Mode=OneWay}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding StatusDisplay, Mode=OneWay}"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ReasonDisplay, Mode=OneWay}"
                                                               FontSize="12" Foreground="#B91C1C" Margin="8,0,8,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CountDisplay, Mode=OneWay}"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--
                                      The button that finishes the job.

                                      It does NOT retry the folders that failed - a folder whose
                                      listing was refused will be refused again. It picks up at
                                      the FRONTIER: the folders the walk wrote but never expanded.
                                      Their contents were never listed and everything below them
                                      was never discovered, so the tree is missing that whole
                                      branch. Listing them and walking down into whatever they
                                      contain is what makes the sync complete.

                                      The busy screen covers the window while it runs, carrying the
                                      live progress and the Stop button.
                                    -->
                                    <Button Content="Continue sync" Command="{Binding ContinueSyncCommand}"
                                            Padding="16,6" MinWidth="120" Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            IsEnabled="{Binding CanContinueSync, Mode=OneWay}"
                                            ToolTip="Lists the folders the previous walk never expanded, then walks down into whatever they contain, until the tree is complete. The part already synced is not listed again." />
                                </StackPanel>
                            </Border>

                            <!--
                              The figures are not known yet. NOT the same as "everything is
                              fine": an index nobody has read is an index nobody can say
                              anything about. So this says what it is actually waiting for.
                            -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="8" Padding="16,12"
                                    Visibility="{Binding Stats.ShowNoStats, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Stats.NoStatsHeadline, Mode=OneWay}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#475569" />
                                    <TextBlock Text="{Binding Stats.NoStatsDetail, Mode=OneWay}"
                                               FontSize="11" Foreground="#64748B" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- All good -->
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                                    CornerRadius="8" Padding="16,12"
                                    Visibility="{Binding Stats.ShowAllGood, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Every synced folder was listed completely - nothing is pending."
                                           FontSize="12" Foreground="#15803D" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
    </Grid>
</UserControl>