<UserControl x:Class="Utility.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Utility.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Connections -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Connections" Style="{StaticResource HeaderText}" />
                    <TextBlock Text="Both sources are read-only."
                               Style="{StaticResource SubHeaderText}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SQL Server"
                                   FontWeight="SemiBold" Foreground="#374151" Margin="0,4,12,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DatabaseStatus}"
                                   FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseDetail}"
                                   FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Dropbox"
                                   FontWeight="SemiBold" Foreground="#374151" Margin="16,4,0,8" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DropBoxStatus}"
                                   HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DropBoxDetail}"
                                   FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="16,2,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Library figures -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Media items" FontSize="12" Foreground="#6B7280" />
                        <TextBlock Text="{Binding MediaCountDisplay}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="#111827" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="System ID" FontSize="12" Foreground="#6B7280" />
                        <TextBlock Text="{Binding SystemId}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="#111827" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Library path" FontSize="12" Foreground="#6B7280" />
                        <TextBlock Text="{Binding LibraryPath}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#111827" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Export path" FontSize="12" Foreground="#6B7280" />
                        <TextBlock Text="{Binding ExportPath}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#111827" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recent exports -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Recent exports" Style="{StaticResource HeaderText}" />
                    <TextBlock Text="Latest rows from ml.ExportHeader."
                               Style="{StaticResource SubHeaderText}" />

                    <ItemsControl ItemsSource="{Binding RecentExports}" MaxHeight="200">
                        <!--
                          Default ItemsPanel: an ItemsControl with an explicit ControlTemplate
                          does not lay out items unless the template supplies an ItemsPresenter.
                        -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Margin="0,1" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>