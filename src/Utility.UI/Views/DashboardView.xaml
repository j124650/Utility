<!--
  Dashboard = the synced Dropbox tree and a toolbar, nothing else.
  Media items / system id / library path / SQL connectivity moved to the window status bar.
  The tree occupies every remaining row and scrolls inside itself, so expanding a node
  scrolls the list rather than resizing the page.
-->
<UserControl x:Class="Utility.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Utility.UI.ViewModels"
             xmlns:sync="clr-namespace:Utility.Server.DropBoxSync;assembly=Utility.Server"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <UserControl.Resources>
        <!--
                          One row style, so every node has identical metrics and nothing reflows.

                          ItemsSource is bound EXPLICITLY to Children. A TreeView only auto-discovers a
                          child collection named "Items"; one named "Children" is ignored, so every node
                          rendered as a leaf with no expander - which looked exactly like broken data.

                          IsExpanded is deliberately NOT bound here. WPF resets it while preparing the
                          container, so a bound value loses that race and the node never opens.
                          DashboardView.xaml.cs copies the model's expansion onto the generated
                          containers instead, and Expanded/Collapsed write the user's clicks back.
                        -->
                        <Style x:Key="TreeRowStyle" TargetType="TreeViewItem">
                            <Setter Property="ItemsSource" Value="{Binding Children}" />
                            <Setter Property="MinHeight" Value="26" />
                            <Setter Property="Padding" Value="2,1,0,1" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Foreground" Value="#111827" />
                            <EventSetter Event="Loaded" Handler="OnTreeItemLoaded" />
                                                <EventSetter Event="Expanded" Handler="OnTreeItemExpanded" />
                                                <EventSetter Event="Collapsed" Handler="OnTreeItemCollapsed" />
                        </Style>

        <Style x:Key="StatPill" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Synced Dropbox tree" FontSize="16" FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Text="Read once from ml.DropBoxNode — no Dropbox calls."
                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Margin="24,0,0,0">
                    <Border Style="{StaticResource StatPill}" ToolTip="Folders present in the synced table.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="Folders " /><Run Text="{Binding FoldersDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" ToolTip="Files present in the synced table.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="Files " /><Run Text="{Binding FilesDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" ToolTip="Files whose pixel dimensions were returned by Dropbox.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="With dims " /><Run Text="{Binding WithDimensionsDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" ToolTip="Total size of synced files.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="Size " /><Run Text="{Binding SizeDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" ToolTip="When the synced rows were last written.">
                        <TextBlock FontSize="12" Foreground="#334155">
                            <Run Text="Synced " /><Run Text="{Binding LastSyncDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatPill}" Background="#FEF2F2"
                            Visibility="{Binding HasUnverified, Converter={StaticResource BoolToVis}}"
                            ToolTip="Folders whose listing did not complete. The sweep never deletes their contents.">
                        <TextBlock Text="{Binding UnverifiedDisplay}" FontSize="12" Foreground="#B91C1C" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Read / Refresh" Command="{Binding ReadTreeCommand}"
                            Padding="14,5" Margin="0,0,8,0" />
                    <Button Content="Expand all" Click="OnExpandAllClick" Padding="12,5" Margin="0,0,6,0" />
                                        <Button Content="Collapse all" Click="OnCollapseAllClick" Padding="12,5" />
                </StackPanel>

                <!--
                  Sync strip: the only part of this page that talks to Dropbox.

                  There are no options here on purpose. The sync walks the folder tree from
                  the root down to the leaves, always, and always fetches each file's own
                  metadata - that is the only route to image dimensions, and skipping it
                  would blank the dimensions already stored. A depth or an enrichment
                  toggle would only narrow what gets synced, which is not a decision the
                  user should have to make to get a correct result.

                  The path is the only input: it is the folder the walk starts from.

                  While the walk runs, the app-level busy screen covers the whole window
                  and carries the live progress and the Stop button - so nothing is
                  reported here. The tree is re-read when that screen is dismissed.
                -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Sync from Dropbox"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <TextBox Grid.Column="1" Text="{Binding SyncPath, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" FontSize="12" Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Dropbox folder to sync, relative to the team namespace root. The whole tree below it is walked." />

                        <Button Grid.Column="2" Content="Sync" Command="{Binding RunSyncCommand}"
                                Padding="14,5" MinWidth="72"
                                IsEnabled="{Binding Sync.IsRunning, Converter={StaticResource InverseBool}}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!--
                  Tree: takes the whole remaining space and scrolls inside its own bounds. The
                  ScrollViewer sits on a fixed-height row, so expanding a node scrolls the content
                  and never changes the height of anything below it.

                  Virtualization is deliberately OFF. IsExpanded is a two-way binding, and a
                  recycled TreeViewItem carries its previous item's expansion state back through
                  that binding - which made "Expand all" appear to do nothing. With a synced
                  subtree this size the panel buys nothing.
                -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}"
                                                          ItemContainerStyle="{StaticResource TreeRowStyle}"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <!-- Fixed widths for the trailing columns. Auto-width columns size to content and
                                                                         ignore margin, which is what made the date and size overlap. -->
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="110" />
                                                                        <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>

                                <!-- Glyph -->
                                <Grid Grid.Column="0" Width="20">
                                    <TextBlock Text="{Binding IsFolder, Converter={StaticResource BoolToIcon}}"
                                               FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>

                                <!-- Name. Synthetic (never-synced) ancestors are italic and muted. -->
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Margin="4,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Name}"
                                           FontStyle="{Binding IsSynced, Converter={StaticResource BoolToFontStyle}}"
                                           FontWeight="{Binding IsFolder, Converter={StaticResource BoolToWeight}}"
                                           Foreground="{Binding IsSynced, Converter={StaticResource BoolToTextBrush}}" />

                                <!-- Not fully listed -->
                                <TextBlock Grid.Column="2" Text="⚠ not fully listed" FontSize="10" Margin="0,0,10,0"
                                           VerticalAlignment="Center" Foreground="#B91C1C"
                                           Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVis}}"
                                           ToolTip="This folder's listing did not complete. The sweep will not delete what is inside it." />

                                <!-- "not synced" marker for synthetic ancestors -->
                                <TextBlock Grid.Column="3" Text="not synced" FontSize="10" Margin="0,0,10,0"
                                           VerticalAlignment="Center" Foreground="#94A3B8"
                                           Visibility="{Binding IsSynced, Converter={StaticResource InverseBoolToVis}}"
                                           ToolTip="This folder appears in a synced path but has no synced data of its own." />

                                <!-- Dimensions -->
                                <TextBlock Grid.Column="4" Text="{Binding DimensionsDisplay}" FontSize="11"
                                           Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#7C3AED"
                                           Visibility="{Binding HasDimensions, Converter={StaticResource BoolToVis}}"
                                           ToolTip="Pixel dimensions reported by Dropbox." />

                                <!-- Size -->
                                                                <TextBlock Grid.Column="5" Text="{Binding SizeDisplay}" FontSize="11"
                                                                                                                   TextAlignment="Right" Margin="0,0,20,0"
                                                                                                                   VerticalAlignment="Center" Foreground="#64748B" />

                                                                                                <!-- Modified -->
                                                                                                        <TextBlock Grid.Column="6" Text="{Binding ModifiedDisplay}" FontSize="11"
                                                                                                                   TextAlignment="Right" Margin="0,0,4,0"
                                                                                                                   VerticalAlignment="Center" Foreground="#94A3B8" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Empty state -->
                <Border Background="#F8FAFC" Padding="24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="No synced rows yet" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#475569" HorizontalAlignment="Center" />
                        <TextBlock Text="Run a sync, then press Read / Refresh to load ml.DropBoxNode."
                                   FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Read error -->
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Padding="14"
                        VerticalAlignment="Top"
                        Visibility="{Binding TreeError, Converter={StaticResource StringToVis}}">
                    <TextBlock Text="{Binding TreeError}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>