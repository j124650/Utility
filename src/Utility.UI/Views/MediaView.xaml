<UserControl x:Class="Utility.UI.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Utility.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MediaViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Media library" Style="{StaticResource HeaderText}" />
                <TextBlock Text="Read-only view of ml.media. Results are paged — the table is large."
                           Style="{StaticResource SubHeaderText}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="File name contains" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FilterText}" Margin="0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0" MinWidth="150">
                        <TextBlock Text="Media type" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding MediaTypes}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding MediaTypeId}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0" MinWidth="150">
                        <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding MediaCategories}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  SelectedValue="{Binding MediaCategoryId}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                        <Button Content="Search" Command="{Binding SearchCommand}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Paging -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{Binding PageDisplay}" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="First page" Command="{Binding FirstPageCommand}" />
                <Button Content="Next page" Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding NextPageEnabled}" />
            </StackPanel>
        </Grid>

        <!-- Results -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Media}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File name" Binding="{Binding FileName}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding MediaTypeId}" Width="60" />
                <DataGridTextColumn Header="Category" Binding="{Binding MediaCategoryId}" Width="80" />
                <DataGridTextColumn Header="Size (bytes)" Binding="{Binding Size}" Width="110" />
                <DataGridTextColumn Header="Added" Binding="{Binding DateAdded}" Width="150" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>