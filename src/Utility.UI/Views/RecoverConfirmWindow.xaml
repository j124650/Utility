<Window x:Class="Utility.UI.Views.RecoverConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover Selected"
        Width="1100"
        Height="640"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF">

    <!--
      The window is SPLIT HORIZONTALLY: the information above, the details table below.
      The figures say how big the job is; the table says what the job is (§10.1.3).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          The scope: how many pairs the filters are showing, and how many of them will
          actually be recovered. Nothing is written until the reader answers.
        -->
        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <TextBlock x:Name="ScopeText"
                       FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock x:Name="RecoverableText"
                       FontSize="13" Foreground="#334155" Margin="0,8,0,0" />
        </StackPanel>

        <!--
          The breakdown by verdict: what will actually happen. A parent copy is not a
          child regeneration, and the reader is about to authorize both.
        -->
        <StackPanel Grid.Row="1" Margin="24,12,24,0">
            <TextBlock x:Name="ParentRestoredText" FontSize="13" Foreground="#334155" />
            <TextBlock x:Name="ChildRegeneratedText" FontSize="13" Foreground="#334155" Margin="0,2,0,0" />
            <TextBlock x:Name="BothText" FontSize="13" Foreground="#334155" Margin="0,2,0,0" />

            <!--
              The two figures that carry a warning. The rest is information. The download
              volume and the replaced-file count are the sentences that change a mind.
            -->
            <TextBlock x:Name="DownloadText" FontSize="13" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,12,0,0" />
            <TextBlock x:Name="ReplacedText" FontSize="13" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,2,0,0" />
            <TextBlock x:Name="FoldersText" FontSize="13" Foreground="#334155" Margin="0,2,0,0" />

            <!--
              The red warning. A line and not a typed word: a typed word is a gate that is
              always there, and a gate that is always there stops being read.
            -->
            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,14,0,0"
                    x:Name="WarningPanel" Visibility="Collapsed">
                <TextBlock x:Name="WarningText"
                           FontSize="13" FontWeight="SemiBold" Foreground="#B91C1C"
                           TextWrapping="Wrap" />
            </Border>

            <!--
              The scope is honest: the rows that are left alone are not the reader's
              fault, and the reader should know how many there are.
            -->
            <TextBlock x:Name="NotRecoveredText"
                       FontSize="12" Foreground="#6B7280"
                       Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!--
          The details table: the ACTIONS, one per row, in the order they will be
          performed - not one row per pair. A pair whose parent and child both need work
          produces two rows (§10.1.4).
        -->
        <Grid Grid.Row="2" Margin="24,16,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="ActionCaption"
                       FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                       Margin="0,0,0,8" />

            <DataGrid Grid.Row="1"
                      x:Name="ActionsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      FontSize="11"
                      BorderBrush="#E5E7EB"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="46" />
                    <DataGridTextColumn Header="Pair" Binding="{Binding Pair}" Width="190" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="130" />
                    <DataGridTextColumn Header="From" Binding="{Binding From}" Width="*" />
                    <DataGridTextColumn Header="To" Binding="{Binding To}" Width="*" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!--
          Cancel is the default: a window that destroys files should not open with the
          destructive action already chosen.
        -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="24,20,24,20">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    IsDefault="True"
                    MinWidth="100" Padding="18,7" Margin="0,0,8,0"
                    Click="OnCancel" />
            <Button x:Name="RecoverButton"
                    Content="Recover"
                    MinWidth="100" Padding="18,7"
                    IsDefault="False"
                    Click="OnRecover" />
        </StackPanel>
    </Grid>
</Window>
