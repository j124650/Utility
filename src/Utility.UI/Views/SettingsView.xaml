<UserControl x:Class="Utility.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Utility.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <!--
      Two rows: the cards scroll, and the actions and the status are PINNED to the
      bottom of the page. The status lives OUTSIDE the scroll viewer on purpose - inside
      it, the result of a click lands below the fold and the button looks dead.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="SQL Server" Style="{StaticResource HeaderText}" />

                        <TextBlock Text="Connection string" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ConnectionString}" FontFamily="Consolas" />

                        <!--
                          The connection test is this card's own action - it tests the
                          connection string - so it stays with it.
                        -->
                        <Button Content="Test connection" Command="{Binding TestDatabaseCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Dropbox" Style="{StaticResource HeaderText}" />
                        <TextBlock Text="Create an app at https://www.dropbox.com/developers/apps, then paste its App Key and a refresh token."
                                   Style="{StaticResource SubHeaderText}" />

                        <TextBlock Text="App key" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DropBoxAppKey}" FontFamily="Consolas" />

                        <TextBlock Text="App secret (optional — PKCE apps have none)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DropBoxAppSecret}" FontFamily="Consolas" />

                        <TextBlock Text="Refresh token" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DropBoxRefreshToken}" FontFamily="Consolas" />

                        <TextBlock Text="Retry budget (0-10)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DropBoxMaxRetries}" FontFamily="Consolas" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--
          The PAGE's actions and its status, pinned below the cards. One save writes the
          SQL settings AND the Dropbox ones, so it sits where it plainly covers the whole
          page rather than inside one card where it would read as that card's action.
        -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save all" Command="{Binding SaveCommand}" />
                <Button Content="Reload" Command="{Binding ReloadCommand}" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Height="2" Margin="0,12,0,6"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12" Foreground="#374151" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
