<!--
  Title is a literal, not a binding: a RelativeSource/AncestorType binding on Window.Title
  is evaluated before the code-behind assigns DataContext, so it fails silently and leaves
  the title empty (which also makes the window undiscernible to automation tools).
-->
<Window x:Class="Utility.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Utility.UI.ViewModels"
        xmlns:views="clr-namespace:Utility.UI.Views"
        mc:Ignorable="d"
        Title="Utility"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <TextBlock Text="Utility" FontSize="18" FontWeight="SemiBold" Foreground="#111827"
                           VerticalAlignment="Center" />
                <TextBlock Text="SQL Server + Dropbox" FontSize="12" Foreground="#6B7280"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Navigation -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NavDashboard" GroupName="Nav" Content="Dashboard"
                             Style="{StaticResource NavButtonStyle}" Checked="OnNavDashboardClick" />
                <RadioButton x:Name="NavDropBox" GroupName="Nav" Content="DropBox files"
                             Style="{StaticResource NavButtonStyle}" Checked="OnNavDropBoxClick" />
                <RadioButton x:Name="NavMedia" GroupName="Nav" Content="Media library"
                             Style="{StaticResource NavButtonStyle}" Checked="OnNavMediaClick" />
                <RadioButton x:Name="NavSettings" GroupName="Nav" Content="Settings"
                             Style="{StaticResource NavButtonStyle}" Checked="OnNavSettingsClick" />
            </StackPanel>
        </Border>

        <!-- Page host -->
        <Grid Grid.Row="2" x:Name="PageHost" Margin="16,16,16,8" />

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#6B7280" />
        </Border>
    </Grid>
</Window>