<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net10.0-windows with UseWPF, because this harness drives WPF's own sorting
      mechanism - the ICollectionView a DataGrid sorts through - to check that the
      Names column sorts by the AMOUNT and not by the text of the number.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GroupsChecks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="..\..\src\Utility.Server\Utility.Server.csproj" />
  </ItemGroup>

</Project>
